              <calculation class='tableau' formula='IF [YearOnYear Profit (copy)_0627045604229132]&gt;0 THEN &quot;▲&quot; ELSE &quot;▼&quot; END' />
            </column>
            <column caption='YOY Profit  indicator' datatype='string' name='[YOY sales indicator (copy)_0627045598068745]' role='measure' type='nominal'>
