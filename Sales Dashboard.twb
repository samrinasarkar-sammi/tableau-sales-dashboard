            <column caption='Total CurrentYear Qty' datatype='integer' name='[Total CurrentYear Profit  (copy)_0627045603860490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Quantity] END' />
            </column>
            <column caption='Total PreviousYear Qty' datatype='integer' name='[Total CurrentYear Qty (copy)_0627045604044811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))}-1 THEN [Quantity] END' />
            </column>
            <column caption='Total CurrentYear Profit ' datatype='real' name='[Total CurrentYear Sales (copy)_0627045597155334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Profit] END' />
            </column>
            <column caption='Total PreviousYear Profit' datatype='real' name='[Total PreviousYear Sales (copy)_0627045597450247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))} - 1 THEN [Profit] END' />
