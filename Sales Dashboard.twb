            </column>
            <column caption='YearOnYear Qty' datatype='real' name='[YearOnYear Profit (copy)_0627045604229132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Total CurrentYear Profit  (copy)_0627045603860490])-SUM([Total CurrentYear Qty (copy)_0627045604044811]))/SUM([Total CurrentYear Qty (copy)_0627045604044811])' />
            </column>
